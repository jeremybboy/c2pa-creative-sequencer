#!/bin/sh
set -eu
RUNTIME_ROOT=${C2PASEQ_AUDFPRINT_RUNTIME:-"${HOME}/Library/Application Support/C2PA Creative Sequencer/Fingerprint"}
FFMPEG_PATH_FILE="${RUNTIME_ROOT}/ffmpeg-path"

if [ -n "${C2PASEQ_FFMPEG_EXECUTABLE:-}" ]; then
    FFMPEG_EXECUTABLE=${C2PASEQ_FFMPEG_EXECUTABLE}
elif [ -f "${FFMPEG_PATH_FILE}" ]; then
    IFS= read -r FFMPEG_EXECUTABLE < "${FFMPEG_PATH_FILE}"
elif command -v ffmpeg >/dev/null 2>&1; then
    FFMPEG_EXECUTABLE=$(command -v ffmpeg)
elif [ -x /opt/homebrew/bin/ffmpeg ]; then
    FFMPEG_EXECUTABLE=/opt/homebrew/bin/ffmpeg
elif [ -x /usr/local/bin/ffmpeg ]; then
    FFMPEG_EXECUTABLE=/usr/local/bin/ffmpeg
else
    echo "audfprint requires ffmpeg; rerun scripts/setup_audfprint.sh" >&2
    exit 1
fi

case "${FFMPEG_EXECUTABLE}" in
    /*) ;;
    *)
        echo "audfprint ffmpeg path must be absolute: ${FFMPEG_EXECUTABLE}" >&2
        exit 1
        ;;
esac
if [ ! -x "${FFMPEG_EXECUTABLE}" ]; then
    echo "audfprint ffmpeg executable is unavailable: ${FFMPEG_EXECUTABLE}" >&2
    exit 1
fi

FFMPEG_DIRECTORY=${FFMPEG_EXECUTABLE%/*}
PATH="${FFMPEG_DIRECTORY}:${PATH:-/usr/bin:/bin}"
export PATH

exec "${RUNTIME_ROOT}/venv/bin/python" "${RUNTIME_ROOT}/lib/audfprint_helper.py" \
    --source "${RUNTIME_ROOT}/source/audfprint" \
    --commit "cb03ba99feafd41b8874307f0f4e808a6ce34362" "$@"
